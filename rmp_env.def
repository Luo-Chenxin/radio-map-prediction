Bootstrap: docker
From: nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04

%post
    export DEBIAN_FRONTEND=noninteractive

    echo "Install miniconda & basic tools..."
    apt-get update && apt-get install -y wget
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    
    # Temporarily add the conda path
    export PATH=/opt/conda/bin:$PATH

    echo "Creating a Conda environment in a container..."
    wget https://raw.githubusercontent.com/Luo-Chenxin/radio-map-prediction/main/environment.yml -O /tmp/environment.yml
    
    # Explicitly accept the terms of service in non-interactive mode
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

    conda env create -f /tmp/environment.yml
    conda clean --all -y
    rm /tmp/environment.yml

%environment
    export PATH=/opt/conda/envs/rmp/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=rmp
    export PYTHONNOUSERSITE=1

%runscript
    echo "Apptainer: rmp environment is ready!"
    exec /bin/bash